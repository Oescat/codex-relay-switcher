+// Local-only handoff: credentials travel in a private pipe and a same-origin, uncached response.
+function relaySwitcherConnection(): Plugin {
+    const helper = resolve(process.env.RELAY_SWITCHER_ROOT || "D:/Switch api", "relay_canvas.py");
+    const run = promisify(execFile);
+    const read = async (mode: string) => {
+        const args = [helper, mode];
+        if (process.env.RELAY_SWITCHER_HOME) args.push("--home", process.env.RELAY_SWITCHER_HOME);
+        const result = await run(process.env.RELAY_SWITCHER_PYTHON || "python", args, { windowsHide: true });
+        return JSON.parse(result.stdout);
+    };
+    return {
+        name: "relay-switcher-connection",
+        apply: "serve",
+        async configureServer(server) {
+            server.middlewares.use("/__relay_switcher/image-connection", async (req, res) => {
+                res.setHeader("Cache-Control", "no-store");
+                res.setHeader("Content-Type", "application/json; charset=utf-8");
+                res.setHeader("Cross-Origin-Resource-Policy", "same-origin");
+                const host = req.headers.host || "";
+                const origin = `http://${host}`;
+                const localHost = /^(127\.0\.0\.1|localhost)(:\d+)?$/.test(host);
+                const localPeer = ["127.0.0.1", "::1", "::ffff:127.0.0.1"].includes(req.socket.remoteAddress || "");
+                if (req.method !== "GET" || !localHost || !localPeer
+                    || req.headers["x-relay-switcher"] !== "canvas"
+                    || (req.headers.origin && req.headers.origin !== origin)
+                    || (req.headers["sec-fetch-site"] && req.headers["sec-fetch-site"] !== "same-origin")) {
+                    res.statusCode = 403;
+                    res.end('{"error":"Local Canvas requests only."}');
+                    return;
+                }
+                try {
+                    res.end(JSON.stringify(await read("--connection-json")));
+                } catch {
+                    res.statusCode = 503;
+                    res.end('{"error":"Switcher connection unavailable."}');
+                }
+            });
+            if (!existsSync(helper)) return;
+            try {
+                const source = resolve(await read("--source-path"));
+                server.watcher.add(source);
+                const changed = (_event: string, file: string) => {
+                    if (resolve(file) === source) server.ws.send({ type: "custom", event: "relay-switcher:changed", data: {} });
+                };
+                server.watcher.on("all", changed);
+                server.httpServer?.once("close", () => server.watcher.off("all", changed));
+            } catch {
