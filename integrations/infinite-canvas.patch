+/** 优先使用显式指定或桌面端的 CLI，避免旧依赖误读已安装插件的认证配置。 */
+function codexCommand() {
+    const override = process.env.CANVAS_CODEX_PATH?.trim();
+    if (override) {
+        if (!path.isAbsolute(override) || !existsSync(override)) throw new Error("CANVAS_CODEX_PATH 必须指向已有的 Codex 可执行文件");
+        return /\.(?:m?js|cjs)$/i.test(override) ? { command: process.execPath, args: [override] } : { command: override, args: [] };
+    }
+    if (process.platform === "win32") {
+        const desktop = Object.entries(process.env).filter(([key]) => key.toLowerCase() === "path")
+            .flatMap(([, value]) => (value || "").split(path.delimiter))
+            .map((entry) => path.join(entry.replace(/^"|"$/g, ""), "codex.exe"))
+            .find((entry) => entry.toLowerCase().includes((path.join("OpenAI", "Codex", "bin") + path.sep).toLowerCase()) && existsSync(entry));
+        if (desktop) return { command: desktop, args: [] };
+    }
+    return { command: process.execPath, args: [path.join(path.dirname(require.resolve("@openai/codex/package.json")), "bin", "codex.js")] };
 }
