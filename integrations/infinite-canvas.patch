+import { decodeChannelModel, resolveModelChannel, SWITCHER_IMAGE_CHANNEL_ID, useConfigStore, type AiConfig, type ModelChannel, type SwitcherImageConnection } from "@/stores/use-config-store";
+
+let latestRequest = 0;
+
+export async function syncSwitcherConnection(): Promise<SwitcherImageConnection | null> {
+    const sequence = ++latestRequest;
+    try {
+        const response = await fetch("/__relay_switcher/image-connection", {
+            cache: "no-store",
+            headers: { "X-Relay-Switcher": "canvas" },
+        });
+        if (!response.ok) throw new Error();
+        const connection: SwitcherImageConnection | null = await response.json();
+        if (connection !== null && (!connection || typeof connection.name !== "string"
+            || typeof connection.baseUrl !== "string" || typeof connection.apiKey !== "string")) throw new Error();
+        if (sequence === latestRequest) useConfigStore.getState().syncSwitcherImageConnection(connection);
+        return connection;
+    } catch {
+        if (sequence === latestRequest) useConfigStore.getState().syncSwitcherImageConnection(null);
+        throw new Error("无法同步 Switcher 生图站点，本次请求未发送。请检查本地服务，并在 Switcher 中重新应用图片站点。");
+    }
+}
+
+export async function refreshSwitcherChannel(channel: ModelChannel): Promise<ModelChannel> {
+    if (!import.meta.env.DEV || channel.id !== SWITCHER_IMAGE_CHANNEL_ID) return channel;
+    const connection = await syncSwitcherConnection();
+    if (!connection) throw new Error("Switcher 尚未应用可用的图片站点，本次请求未发送。");
+    return { ...channel, baseUrl: connection.baseUrl, apiKey: connection.apiKey };
+}
+
+export async function refreshSwitcherImageConfig(config: AiConfig): Promise<AiConfig> {
+    const value = config.model || config.imageModel;
+    if (!import.meta.env.DEV || decodeChannelModel(value)?.channelId !== SWITCHER_IMAGE_CHANNEL_ID) return config;
+    const channel = await refreshSwitcherChannel(resolveModelChannel(config, value));
+    return { ...config, channels: config.channels.map((item) => item.id === SWITCHER_IMAGE_CHANNEL_ID ? channel : item) };
+}
